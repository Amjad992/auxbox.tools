#!/usr/bin/env sh
# Pre-commit: lint -> tests -> changelog enforcement.
# NEVER bypass with --no-verify. If a hook fails, fix the underlying issue.

set -e

staged=$(git diff --cached --name-only)
if [ -z "$staged" ]; then
  exit 0
fi

# Lint.
echo "[pre-commit] lint"
npm run -s lint

# Tests (passes with no tests).
echo "[pre-commit] test"
npm test --silent -- --run

# Changelog enforcement (single-project mode):
# Any staged source file outside .agents/ requires .agents/changelog.md to be staged.
src_changes=$(printf '%s\n' "$staged" \
  | grep -vE '^\.agents/' \
  | grep -vE '^playground/' \
  | grep -vE '^README\.md$' \
  | grep -vE 'package-lock\.json$' \
  | grep -vE '^\.husky/' \
  | grep -vE '^\.gitignore$' || true)

if [ -n "$src_changes" ]; then
  if ! printf '%s\n' "$staged" | grep -qF '.agents/changelog.md'; then
    printf '\n[pre-commit] Changelog update required\n'
    printf 'Source files staged without updating .agents/changelog.md:\n'
    printf '%s\n' "$src_changes" | sed 's/^/  /'
    printf '\nEntry format (append to .agents/changelog.md):\n'
    printf '  ## YYYY-MM-DD - Short title\n'
    printf '  **What changed:** ...\n'
    printf '  **Why:** ...\n'
    printf '  **Impact:** ...\n'
    printf '  **Files changed:** ...\n\n'
    printf 'Then: git add .agents/changelog.md && git commit ...\n'
    exit 1
  fi
fi

exit 0
